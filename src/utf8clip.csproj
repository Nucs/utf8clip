<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BlueMarsh.Utf8Clip</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0</FileVersion>
    <Company>bluemarsh labs</Company>
    <Copyright>Copyright (c) 2019 Aaron Meyers, 2024 Cross-platform by EliBelash</Copyright>
    <Description>Cross-platform UTF-8 clipboard tool. Windows (native), Linux (xclip/xsel), macOS (pbcopy/pbpaste).</Description>
    <RepositoryUrl>https://github.com/bluemarsh/utf8clip</RepositoryUrl>
    <PackageTags>clipboard, console, PowerShell, utf8, cross-platform</PackageTags>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- AOT settings - activated when PublishAot=true is passed -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
  </PropertyGroup>

</Project>
