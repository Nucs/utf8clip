<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nucs.Utf8Clip</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Version - set via CLI: -p:Version=2.1.0 -->
    <Version>2.1.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>

    <!-- Git commit - set via CLI: -p:SourceRevisionId=abc1234 -->
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">local</SourceRevisionId>
    <InformationalVersion>$(Version)+$(SourceRevisionId)</InformationalVersion>

    <!-- Assembly metadata -->
    <Company>Nucs</Company>
    <Authors>Aaron Meyers, EliBelash</Authors>
    <Copyright>Copyright (c) 2019 Aaron Meyers, 2024-2025 Cross-platform by EliBelash</Copyright>
    <Description>Cross-platform UTF-8 clipboard tool with emoji support. Windows (native), Linux (xclip/xsel), macOS (pbcopy/pbpaste).</Description>
    <RepositoryUrl>https://github.com/Nucs/utf8clip</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>clipboard, console, PowerShell, utf8, cross-platform, emoji</PackageTags>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- AOT settings - activated when PublishAot=true is passed -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
  </PropertyGroup>

</Project>
